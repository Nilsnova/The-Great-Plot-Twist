{
  "name": "the-great-plot-twist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node scripts/check-browser.js",
    "test:art": "node scripts/check-pixel.js",
    "test:art:production": "npm run build && ART_PRODUCTION=1 node scripts/check-pixel.js",
    "test:production": "npm run build && node scripts/check-production.js",
    "test:world": "node scripts/check-world.js",
    "test:readability": "node scripts/check-readability.js",
    "test:ui": "node scripts/check-ui-kit.js",
    "test:ui:production": "npm run build && KIT_PRODUCTION=1 node scripts/check-ui-kit.js",
    "test:cinematics": "node scripts/check-cinematics.js"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
