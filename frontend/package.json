{
  "name": "the-great-plot-twist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/check-spoilers.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node scripts/check-browser.js",
    "test:art": "node scripts/check-pixel.js",
    "test:art:production": "npm run build && ART_PRODUCTION=1 node scripts/check-pixel.js",
    "test:production": "npm run build && node scripts/check-production.js",
    "test:world": "node scripts/check-world.js",
    "test:readability": "node scripts/check-readability.js",
    "test:ui": "node scripts/check-ui-kit.js",
    "test:ui:production": "npm run build && KIT_PRODUCTION=1 node scripts/check-ui-kit.js",
    "test:cinematics": "node scripts/check-cinematics.js",
    "test:intro": "node scripts/check-intro.js",
    "test:weather:wiring": "node scripts/check-weather-wiring.js",
    "test:experience": "node scripts/check-experience.js",
    "test:demo": "node scripts/check-demo.js",
    "test:loading": "npm run build && node scripts/check-loading.js",
    "test:spoilers": "npm run build",
    "test:case": "node scripts/check-case.js",
    "test:credits": "node scripts/check-credits.js",
    "test:living": "node scripts/check-living.js",
    "test:life": "node scripts/check-life.js",
    "test:lifecycle": "node scripts/check-lifecycle.js",
    "test:golden": "node scripts/check-golden-path.js",
    "test:chaos": "node scripts/check-chaos.js",
    "test:g7": "node scripts/check-g7-regression.js",
    "test:csp": "npm run build && node scripts/check-csp.js",
    "art:fingerprints": "node scripts/generate-reveal-fingerprints.js",
    "test:islet:world": "node scripts/check-islet-world.js",
    "test:bulletin": "node scripts/check-bulletin.js",
    "test:hook": "node scripts/check-hook.js",
    "test:harbor:life": "node scripts/check-harbor-life.js",
    "test:presenter": "npm run build && node scripts/check-presenter.js",
    "test:a11y": "node scripts/check-a11y.js",
    "test:g8": "node scripts/check-g8-regression.js",
    "test:festival": "node scripts/check-festival.js",
    "test:festival:ui": "node scripts/check-festival-ui.js"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
