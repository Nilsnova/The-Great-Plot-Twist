{
  "name": "the-great-plot-twist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/check-spoilers.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node scripts/check-browser.js",
    "test:host": "node scripts/check-host-console.js",
    "test:art": "node scripts/check-pixel.js",
    "test:art:production": "npm run build && ART_PRODUCTION=1 node scripts/check-pixel.js",
    "test:production": "npm run build && node scripts/check-production.js",
    "test:world": "node scripts/check-world.js",
    "test:readability": "node scripts/check-readability.js",
    "test:ui": "node scripts/check-ui-kit.js",
    "test:ui:production": "npm run build && KIT_PRODUCTION=1 node scripts/check-ui-kit.js",
    "test:weather:wiring": "node scripts/check-weather-wiring.js",
    "test:demo": "node scripts/check-demo-journey.js",
    "capture:wow": "node scripts/capture-wow.js",
    "test:loading": "npm run build && node scripts/check-loading.js",
    "test:spoilers": "npm run build",
    "test:credits": "node scripts/check-credits.js",
    "test:living": "node scripts/check-living.js",
    "test:lifecycle": "node scripts/check-lifecycle.js",
    "test:csp": "npm run build && node scripts/check-csp.js",
    "art:fingerprints": "node scripts/generate-reveal-fingerprints.js",
    "test:islet:world": "node scripts/check-islet-world.js",
    "test:harbor:life": "node scripts/check-harbor-life.js",
    "test:a11y": "node scripts/check-a11y.js",
    "test:festival": "node scripts/check-festival.js",
    "test:help": "node scripts/check-help.js",
    "test:build-stamp": "npm run build && node scripts/check-build-stamp.js",
    "test:problem-report": "npm run build && node scripts/check-problem-report.js",
    "test:csp:inventory": "npm run build && node scripts/check-csp-inventory.js",
    "print:headers": "node scripts/security-headers.js",
    "test:title-start": "node scripts/check-title-start.js",
    "test:online:islet": "npm run build && node scripts/check-online-islet.js",
    "test:online:islet:chaos": "npm run build && node scripts/check-online-islet.js --chaos",
    "test:market": "npm run build && node scripts/check-market-hall.js",
    "test:input": "vitest run --maxWorkers=1 tests/g20-input.test.js tests/map-touch.test.js tests/tap-path.test.js",
    "test:mobile": "node scripts/check-mobile-walking.js",
    "test:panels": "node scripts/check-open-panels.js",
    "test:settings:visuals": "node scripts/check-settings-visuals.js"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
